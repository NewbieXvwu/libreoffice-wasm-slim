+ifneq ($(ENABLE_NSS)$(ENABLE_OPENSSL),)
 $(eval $(call gb_Module_add_targets,xmlsec,\
 	UnpackedTarball_xmlsec \
 	ExternalPackage_xmlsec \
 	ExternalProject_xmlsec \
 ))
+endif
 
